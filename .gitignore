# Dependencies
# No trailing slash: that form matches directories ONLY, so a `node_modules`
# SYMLINK — which is how a git worktree gets pointed at the main checkout's
# install — is not ignored, shows up as an untracked path, and can be swept
# into a commit by `git add -A`. It has been, once, to the tune of ~13k files.
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production builds
dist/
build/
target/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Tauri specific
src-tauri/target/
src-tauri/Cargo.lock

# Rust
**/*.rs.bk

# Temporary folders
tmp/
temp/

# Generated QA/benchmark evidence (never commit) — belt-and-suspenders with
# nautilus-bot/.gitignore in case a build/rename experiment lands outside it
artifacts/
dist-electron/
dist-native/
release/
/release-*/
/nautilus-bot/release-*/

# Stray duplicate/rename-experiment checkouts of the app that have
# accidentally ended up at the repo root (see git history 2026-06-22)
/plainsong/
