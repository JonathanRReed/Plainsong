# Dependencies
# No trailing slash — see the note in the repository-root .gitignore: the
# directory-only form let a `node_modules` symlink into a commit.
node_modules
.pnp
.pnp.js

# Build outputs
dist/
dist-electron/
dist-native/
release/
/release-*/
manifests/
dist-ssr/
*.local

# Generated QA/benchmark evidence. Raw captures (audio, logs, bundles) stay
# out, but the Markdown/JSON receipts under artifacts/qa/ are tracked by
# default so evidence cited from docs, LAUNCH.md and the CHANGELOG is not
# silently dropped. The two dictation-latency JSON receipts stay ignored on
# purpose: they are regenerated per machine by `bun run benchmark:latency`
# and attached to release evidence by hand (see 05dfc4a6).
artifacts/**
!artifacts/qa/
!artifacts/qa/**/
!artifacts/qa/**/*.md
!artifacts/qa/**/*.json
artifacts/qa/dictation-latency.json
artifacts/qa/dictation-latency-e2e.json

# Python bytecode
__pycache__/
*.pyc

# Rust sidecar
/rust-sidecar/target/
/rust-sidecar/vendor/**/target/
/rust-sidecar/WixTools/
/rust-sidecar/gen/
/rust-sidecar/binaries/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
*.lcov

# Environment variables
.env
.env.local
.env.*.local

# Database
*.db
*.db-shm
*.db-wal

# Temporary files
*.tmp
*.temp
.cache/

# macOS
.AppleDouble
.LSOverride

# Windows
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
