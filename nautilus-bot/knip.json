{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/overlay-root.tsx",
    "electron/main.ts",
    "electron/preload.ts",
    "scripts/capture-packaged-macos-app-matrix-insertion.mjs",
    "scripts/verify-packaged-macos-app-matrix-insertion.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "electron/**/*.ts",
    "scripts/**/*.mjs",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "ignore": [
    "dist/**",
    "dist-electron/**",
    "release/**"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css"
  ]
}
