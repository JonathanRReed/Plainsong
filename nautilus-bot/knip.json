{
  "$schema": "https://unpkg.com/knip@6.32.2/schema.json",
  "entry": [
    "src/main.tsx",
    "src/overlay-root.tsx",
    "electron/main.ts",
    "electron/preload.ts",
    "scripts/capture-packaged-macos-app-matrix-insertion.mjs",
    "scripts/capture-packaged-macos-recovery-shortcuts.mjs",
    "scripts/sanitize-meeting-soak-receipt.mjs",
    "scripts/sign-macos.mjs",
    "scripts/verify-macos-speech-helper.mjs",
    "scripts/verify-macos-system-audio.mjs",
    "scripts/verify-packaged-macos-app-matrix-insertion.mjs",
    "scripts/verify-packaged-native-helpers.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "electron/**/*.ts",
    "scripts/**/*.mjs",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "ignore": [
    "dist/**",
    "dist-electron/**",
    "release/**"
  ],
  "ignoreBinaries": [
    "ditto",
    "hdiutil",
    "osascript",
    "pbcopy",
    "pbpaste",
    "pgrep",
    "say",
    "sqlite3",
    "SwitchAudioSource",
    "swiftc"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreIssues": {
    "electron/macos-updater-staging.ts": ["exports"],
    "src/lib/backend.ts": ["exports"],
    "src/lib/backend/recordings.ts": ["types"],
    "src/lib/backend/settings.ts": ["exports", "types"]
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
