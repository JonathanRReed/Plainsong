{
  "$schema": "https://unpkg.com/knip@6.32.2/schema.json",
  "entry": [
    "src/main.tsx",
    "src/overlay-root.tsx",
    "electron/main.ts",
    "electron/preload.ts",
    "scripts/capture-packaged-macos-app-matrix-insertion.ts",
    "scripts/capture-packaged-macos-recovery-shortcuts.ts",
    "scripts/eval-dictation-meaning.mjs",
    "scripts/lib/isolated-ollama-eval.test.mjs",
    "scripts/lib/ollama-eval-safety.test.mjs",
    "scripts/sanitize-meeting-soak-receipt.ts",
    "scripts/score-native-asr-eval.ts",
    "scripts/sign-macos.mjs",
    "scripts/verify-macos-speech-helper.mjs",
    "scripts/verify-macos-system-audio.ts",
    "scripts/verify-packaged-macos-app-matrix-insertion.ts",
    "scripts/verify-packaged-native-helpers.mjs",
    "scripts/qa/candidate-b24-tools/session-driver.ts",
    "scripts/qa/record-release-review.ts",
    "scripts/qa/write-candidate-receipts.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "electron/**/*.ts",
    "scripts/**/*.{mjs,ts}",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "ignore": [
    "dist/**",
    "dist-electron/**",
    "release/**"
  ],
  "ignoreBinaries": [
    "check",
    "ditto",
    "ffmpeg",
    "hdiutil",
    "osascript",
    "pbcopy",
    "pbpaste",
    "pgrep",
    "say",
    "sqlite3",
    "SwitchAudioSource",
    "swiftc"
  ],
  "ignoreDependencies": [
    "app-builder-lib",
    "builder-util",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreIssues": {
    "electron/macos-updater-staging.ts": ["exports"],
    "src/lib/backend.ts": ["exports"],
    "src/lib/backend/recordings.ts": ["types"],
    "src/lib/backend/settings.ts": ["exports", "types"]
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
