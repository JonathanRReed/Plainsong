{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nautilusbot.app/schemas/ci/cloud-asr-smoke.schema.json",
  "title": "Cloud ASR Smoke Gate Artifact",
  "type": "object",
  "required": ["fixture", "generatedAt", "medianLatencyMs", "thresholdMs", "results"],
  "properties": {
    "fixture": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "medianLatencyMs": { "type": "number", "minimum": 0 },
    "thresholdMs": { "type": "number", "exclusiveMinimum": 0 },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["provider", "elapsedMs", "textLength"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "elapsedMs": { "type": "number", "minimum": 0 },
          "textLength": { "type": "number", "minimum": 1 }
        }
      }
    }
  }
}
