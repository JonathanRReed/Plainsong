{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nautilusbot.app/schemas/ci/asr-preflight.schema.json",
  "title": "ASR Provisioning Preflight Artifact",
  "type": "object",
  "required": [
    "generatedAt",
    "platform",
    "modelsRoot",
    "strict",
    "cloudSecrets",
    "python",
    "providers",
    "summary"
  ],
  "properties": {
    "generatedAt": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "modelsRoot": { "type": "string", "minLength": 1 },
    "strict": {
      "type": "object",
      "required": ["secrets", "assets"],
      "properties": {
        "secrets": { "type": "boolean" },
        "assets": { "type": "boolean" }
      }
    },
    "cloudSecrets": {
      "type": "object",
      "required": ["entries", "missing", "ready"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "present"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "present": { "type": "boolean" }
            }
          }
        },
        "missing": { "type": "array", "items": { "type": "string" } },
        "ready": { "type": "boolean" }
      }
    },
    "python": {
      "type": "object",
      "required": ["candidates", "checks"],
      "properties": {
        "candidates": { "type": "array", "items": { "type": "string" } },
        "selected": { "type": ["string", "null"] },
        "checks": {
          "type": "object",
          "required": ["voxtral_local"],
          "properties": {
            "voxtral_local": { "type": "object" }
          }
        }
      }
    },
    "providers": { "type": "object" },
    "summary": {
      "type": "object",
      "required": ["providerCount", "providersReady", "failingProviders", "cloudSecretsReady"],
      "properties": {
        "providerCount": { "type": "number", "minimum": 1 },
        "providersReady": { "type": "number", "minimum": 0 },
        "failingProviders": { "type": "array" },
        "cloudSecretsReady": { "type": "boolean" }
      }
    }
  }
}
