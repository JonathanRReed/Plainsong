{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nautilusbot.app/schemas/ci/benchmark-gate-result.schema.json",
  "title": "Benchmark Gate Result",
  "type": "object",
  "required": [
    "generatedAt",
    "baselinePath",
    "candidatePath",
    "schemaPath",
    "thresholds",
    "metrics",
    "checks",
    "pass"
  ],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "baselinePath": { "type": "string", "minLength": 1 },
    "candidatePath": { "type": "string", "minLength": 1 },
    "schemaPath": { "type": "string", "minLength": 1 },
    "thresholds": {
      "type": "object",
      "required": ["commandMin", "snippetMin", "latencyImprovementMin"],
      "properties": {
        "commandMin": { "type": "number", "minimum": 0, "maximum": 1 },
        "snippetMin": { "type": "number", "minimum": 0, "maximum": 1 },
        "latencyImprovementMin": { "type": "number", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "baselineP50EndToEndMs",
        "candidateP50EndToEndMs",
        "latencyImprovement",
        "commandSuccessRate",
        "snippetSuccessRate"
      ],
      "properties": {
        "baselineP50EndToEndMs": { "type": "number", "minimum": 0 },
        "candidateP50EndToEndMs": { "type": "number", "minimum": 0 },
        "latencyImprovement": { "type": "number" },
        "commandSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "snippetSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "pass", "actual", "required", "comparator"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "pass": { "type": "boolean" },
          "actual": {},
          "required": {},
          "comparator": { "type": "string", "minLength": 1 },
          "details": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "pass": { "type": "boolean" }
  }
}
