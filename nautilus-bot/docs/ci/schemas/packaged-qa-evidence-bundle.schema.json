{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nautilusbot.app/schemas/ci/packaged-qa-evidence-bundle.schema.json",
  "title": "Packaged QA Evidence Bundle",
  "type": "object",
  "required": ["generatedAt", "matrixPath", "summary", "rows"],
  "properties": {
    "generatedAt": { "type": "string", "minLength": 1 },
    "matrixPath": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": ["total", "pass", "fail", "blocked", "pending"],
      "properties": {
        "total": { "type": "number", "minimum": 1 },
        "pass": { "type": "number", "minimum": 0 },
        "fail": { "type": "number", "minimum": 0 },
        "blocked": { "type": "number", "minimum": 0 },
        "pending": { "type": "number", "minimum": 0 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["area", "testCase", "status", "evidence", "owner"],
        "properties": {
          "area": { "type": "string", "minLength": 1 },
          "testCase": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "PENDING"] },
          "evidence": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    }
  }
}
