{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nautilusbot.app/schemas/evals/corpus-manifest.schema.json",
  "title": "Nautilus SOTA Corpus Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "baselineDate",
    "hardwareProfile",
    "providerMatrix",
    "datasets",
    "scorecardThresholds",
    "competitorBaseline",
    "capabilityParity"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "baselineDate": { "type": "string", "format": "date" },
    "hardwareProfile": {
      "type": "object",
      "required": ["label", "platformClass", "ramGb"],
      "properties": {
        "label": { "type": "string" },
        "platformClass": { "type": "string" },
        "ramGb": { "type": "number", "minimum": 4 },
        "notes": { "type": "string" }
      }
    },
    "providerMatrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["providerType", "modelId", "launchBlocking"],
        "properties": {
          "providerType": { "type": "string" },
          "modelId": { "type": "string" },
          "launchBlocking": { "type": "boolean" }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "language", "blocking", "items"],
        "properties": {
          "id": { "type": "string" },
          "language": { "type": "string" },
          "blocking": { "type": "boolean" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "taskType", "durationSeconds", "audioPath", "groundTruthPath"],
              "properties": {
                "id": { "type": "string" },
                "taskType": { "type": "string", "enum": ["dictation", "meeting"] },
                "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
                "audioPath": { "type": "string" },
                "groundTruthPath": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "scorecardThresholds": {
      "type": "object",
      "required": [
        "crashFreeSessionsMin",
        "providerSuccessRateMin",
        "localRtfP95Max",
        "cloudMedianLatencyMsMax",
        "dictationEndToEndLatencyP95MsMax",
        "meetingWerMax",
        "dictationWerMax",
        "diarizationDerMax",
        "summaryFactualityMin",
        "actionItemF1Min"
      ],
      "properties": {
        "crashFreeSessionsMin": { "type": "number" },
        "providerSuccessRateMin": { "type": "number" },
        "localRtfP95Max": { "type": "number" },
        "cloudMedianLatencyMsMax": { "type": "number" },
        "dictationEndToEndLatencyP95MsMax": { "type": "number" },
        "meetingWerMax": { "type": "number" },
        "dictationWerMax": { "type": "number" },
        "diarizationDerMax": { "type": "number" },
        "summaryFactualityMin": { "type": "number" },
        "actionItemF1Min": { "type": "number" }
      }
    },
    "competitorBaseline": {
      "type": "object",
      "required": ["sourceFile", "relativeImprovement", "rule"],
      "properties": {
        "sourceFile": { "type": "string" },
        "relativeImprovement": { "type": "number", "exclusiveMinimum": 0 },
        "rule": { "type": "string" }
      }
    },
    "capabilityParity": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "boolean" }
    }
  }
}
