{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nautilusbot.app/schemas/evals/benchmark-run.schema.json",
  "title": "Nautilus Dictation Benchmark Run",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "build",
    "platform",
    "rows",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "build": {
      "type": "object",
      "required": ["version", "commit"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 7 }
      }
    },
    "platform": {
      "type": "object",
      "required": ["os", "osVersion", "device"],
      "properties": {
        "os": { "type": "string", "enum": ["macOS", "Windows"] },
        "osVersion": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "appTarget",
          "requestedProvider",
          "actualProvider",
          "isFallback",
          "transcriptionLatencyMs",
          "endToEndMs",
          "insertionOutcome",
          "insertionModeUsed",
          "commandApplied",
          "snippetAppliedCount"
        ],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "scenarioId": { "type": "string", "minLength": 1 },
          "scenarioLabel": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "appTarget": { "type": "string", "minLength": 1 },
          "requestedProvider": { "type": "string", "minLength": 1 },
          "actualProvider": { "type": "string", "minLength": 1 },
          "isFallback": { "type": "boolean" },
          "fallbackReason": { "type": ["string", "null"] },
          "transcriptionLatencyMs": { "type": "number", "minimum": 0 },
          "endToEndMs": { "type": "number", "minimum": 0 },
          "insertionOutcome": {
            "type": "string",
            "enum": ["pasted", "copied", "none", "command_only"]
          },
          "insertionModeUsed": {
            "type": "string",
            "enum": ["auto", "paste", "clipboard_only", "command_only", "none"]
          },
          "commandApplied": { "type": ["string", "null"] },
          "snippetAppliedCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "sampleCount",
        "insertionSuccessRate",
        "commandSuccessRate",
        "snippetSuccessRate",
        "p50EndToEndMs",
        "p95EndToEndMs"
      ],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 1 },
        "insertionSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "commandSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "snippetSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "p50EndToEndMs": { "type": "number", "minimum": 0 },
        "p95EndToEndMs": { "type": "number", "minimum": 0 }
      }
    }
  }
}
