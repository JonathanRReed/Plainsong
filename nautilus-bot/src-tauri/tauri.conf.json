{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Nautilus - Verifiable Memory Layer for dictation and meeting capture",
    "macOS": {
      "entitlements": "../src-tauri/Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "Verifiable Memory Layer",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "Nautilus",
  "version": "1.0.0",
  "identifier": "com.nautilus.app",
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "capabilities": ["main-capability"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "https://fonts.gstatic.com"
      }
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Nautilus",
        "width": 1200,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  }
}
