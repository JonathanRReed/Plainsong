{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "© 2026 NautilusBot. All rights reserved.",
    "externalBin": [
      "binaries/nautilus-macos-speech-helper"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Nautilus - Verifiable Memory Layer for dictation and meeting capture",
    "macOS": {
      "entitlements": "../src-tauri/Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "infoPlist": "../src-tauri/macos-info.plist",
      "minimumSystemVersion": "10.15",
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "Verifiable Memory Layer",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "Nautilus",
  "version": "1.0.0",
  "identifier": "com.nautilus.bot",
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.nautilusbot.com/updates/{{target}}/{{arch}}/{{current_version}}",
        "https://updates.nautilusbot.com/updates/{{target}}/{{arch}}/{{current_version}}?channel={{channel}}"
      ],
      "dialog": false,
      "pubkey": "TODO_REPLACE_WITH_OUTPUT_OF_tauri_signer_generate"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "capabilities": [
        "main-capability"
      ],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://nautilusbot.jonathanrreed.com",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "https://fonts.gstatic.com"
      }
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Nautilus",
        "width": 1200,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  }
}
