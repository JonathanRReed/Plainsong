{
  "name": "plainsong",
  "version": "0.9.0-beta.7",
  "description": "Plainsong - free, open-source, local-first dictation and meeting capture",
  "productName": "Plainsong",
  "private": true,
  "packageManager": "bun@1.4.4",
  "main": "dist-electron/main.js",
  "scripts": {
    "lint": "bun run typecheck && bun run lint:js && bun run lint:rust",
    "lint:js": "bun scripts/lint-js.ts",
    "lint:rust": "bun scripts/cargo-sidecar.ts fmt --check && bun scripts/cargo-sidecar.ts clippy --locked --all-targets -- -D warnings",
    "test": "vitest run --configLoader runner",
    "test:vitest": "vitest run --configLoader runner",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p tsconfig.electron.json && bunx tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:bun": "bun check --threads 1 -p tsconfig.json && bun check --threads 1 -p tsconfig.electron.json && bun check --threads 1 -p tsconfig.scripts.json",
    "dev": "bun run electron:compile && bun scripts/dev-electron.ts",
    "sidecar:build:release": "bun scripts/build-rust-sidecar.ts",
    "shortcut-helper:build": "bun scripts/build-native-shortcut-helper.ts",
    "calendar-helper:build": "node scripts/build-native-calendar-helper.mjs",
    "language-model-helper:build": "bun scripts/build-native-language-model-helper.ts",
    "asr-helper:build": "bun scripts/build-native-asr-helper.ts",
    "language-model-helper:test": "bun scripts/test-native-macos-language-model-helper.ts",
    "notes:fidelity": "python3 scripts/evaluate-notes-fidelity.py",
    "notes:fidelity:test": "python3 scripts/test-evaluate-notes-fidelity.py",
    "notes:evaluate:test": "python3 scripts/test-evaluate-local-notes.py",
    "notes:variants": "python3 scripts/evaluate-notes-variants.py",
    "notes:variants:test": "python3 scripts/test-evaluate-notes-variants.py",
    "text-helper:build": "bun scripts/build-native-text-helper.ts",
    "build:renderer": "vite build --configLoader runner",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "bun run electron:build",
    "preview": "vite preview --configLoader runner",
    "electron:compile": "bun run build:electron",
    "electron:dev": "bun run dev",
    "electron:build": "bun run sidecar:build:release && bun run shortcut-helper:build && bun run calendar-helper:build && bun run language-model-helper:build && bun run asr-helper:build && bun run text-helper:build && bun run build:renderer && bun run build:electron && bun scripts/build-electron-release.ts build",
    "electron:build:all": "bun run electron:build",
    "electron:build:mac": "bun scripts/assert-host-platform.ts darwin arm64 && bun run sidecar:build:release && bun run shortcut-helper:build && bun run calendar-helper:build && bun run language-model-helper:build && bun run asr-helper:build && bun run text-helper:build && bun run build:renderer && bun run build:electron && electron-builder --mac zip --publish never",
    "electron:build:win": "bun scripts/assert-host-platform.ts win32 && bun run sidecar:build:release && bun run shortcut-helper:build && bun run calendar-helper:build && bun run language-model-helper:build && bun run asr-helper:build && bun run text-helper:build && bun run build:renderer && bun run build:electron && electron-builder --win nsis --publish never",
    "electron:build:dmg": "bun scripts/assert-host-platform.ts darwin arm64 && bun run electron:build:mac && bun scripts/build-dmg.ts",
    "electron:pack": "bun run sidecar:build:release && bun run shortcut-helper:build && bun run calendar-helper:build && bun run language-model-helper:build && bun run asr-helper:build && bun run text-helper:build && bun run build:renderer && bun run build:electron && bun scripts/build-electron-release.ts pack",
    "release:mac": "bun scripts/assert-host-platform.ts darwin arm64 && bun scripts/release-mac.mjs",
    "release:mac:compile": "bun run sidecar:build:release && bun run shortcut-helper:build && bun run calendar-helper:build && bun run language-model-helper:build && bun run asr-helper:build && bun run text-helper:build && bun run build:renderer && bun run build:electron",
    "release:win": "bun scripts/assert-host-platform.ts win32 && bun run sidecar:build:release && bun run shortcut-helper:build && bun run calendar-helper:build && bun run language-model-helper:build && bun run asr-helper:build && bun run text-helper:build && bun run build:renderer && bun run build:electron && electron-builder --win nsis --publish never",
    "test:rust": "bun scripts/cargo-sidecar.ts test --locked --lib --bins",
    "benchmark:latency": "bun scripts/cargo-sidecar.ts run --release --locked --bin benchmark-latency --",
    "eval:asr-wer": "bun scripts/eval-asr-wer.ts",
    "pin:hf-artifact": "bun scripts/pin-hf-artifact.ts",
    "gate:dictation-latency": "bun scripts/verify-dictation-latency.ts --input artifacts/qa/dictation-latency.json",
    "gate:dictation-latency:e2e": "bun scripts/verify-dictation-latency.ts --input artifacts/qa/dictation-latency-e2e.json",
    "licenses:generate": "bun scripts/generate-third-party-notices.ts",
    "gate:release-credentials:preflight": "bun scripts/release-credentials-preflight.ts",
    "gate:release:dependencies": "bun scripts/verify-release-dependency-audit.ts",
    "gate:release:rust-dependencies": "bun scripts/verify-rust-release-audit.ts",
    "gate:release:licenses": "bun scripts/generate-third-party-notices.ts --verify-app release/mac-arm64/Plainsong.app",
    "gate:release:macos:trust": "bun scripts/verify-macos-release-trust.ts",
    "gate:packaged:macos:native": "node scripts/verify-packaged-native-helpers.mjs --app release/mac-arm64/Plainsong.app --arch arm64",
    "gate:size": "bun scripts/size-gate.ts --app release/mac-arm64/Plainsong.app --max-mb 450",
    "gate:process-start-diagnostic": "bun scripts/cold-start-gate.ts --threshold-ms 2500 --ready-output-pattern \"App rendered\" --electron-logging --isolate-plainsong-data -- release/mac-arm64/Plainsong.app/Contents/MacOS/Plainsong",
    "gate:cold-start": "bun run gate:process-start-diagnostic",
    "gate:packaged:macos:launch-performance": "bun scripts/capture-packaged-macos-launch-performance.ts --threshold-ms 1500",
    "gate:ipc-contract": "bun scripts/verify-ipc-contract.ts",
    "gate:rust-features": "bun scripts/gate-rust-features.ts",
    "gate:dead-code": "bunx --no-install knip --reporter compact --no-progress && bun scripts/verify-dead-code-hygiene.ts",
    "gate:release:local": "bun run gate:release:rust-dependencies && bun run lint && bun run test && bun run test:rust && bun run gate:ipc-contract && bun run electron:build && bun run gate:release:dependencies",
    "qa:cloud-asr:smoke": "bun scripts/live-cloud-asr-smoke.ts --out artifacts/cloud-asr-smoke.json",
    "qa:asr:preflight": "bun scripts/provision-asr-assets.ts --validate-only --allow-missing-secrets --required-providers whisper,parakeet_tdt_v3,distil_whisper --out artifacts/asr-preflight-macos.json",
    "qa:packaged:macos:smoke": "bun scripts/capture-packaged-macos-smoke.ts",
    "qa:packaged:macos:onboarding": "bun scripts/capture-packaged-macos-onboarding-settings.ts",
    "qa:packaged:macos:onboarding-first-run": "bun scripts/capture-packaged-macos-onboarding-first-run.ts",
    "qa:packaged:macos:backup": "bun scripts/capture-packaged-macos-backup-restore.ts",
    "qa:packaged:macos:whisper": "bun scripts/capture-packaged-macos-whisper-transcription.ts",
    "qa:packaged:macos:ollama": "bun scripts/capture-packaged-macos-ollama-analysis.ts",
    "qa:packaged:macos:dictation-hotkey": "bun scripts/capture-packaged-macos-dictation-hotkey.ts",
    "qa:packaged:macos:dictation-hotkey:hold": "bun scripts/capture-packaged-macos-dictation-hotkey.ts --mode hold",
    "qa:packaged:macos:dictation-hotkey:hands-free": "bun scripts/capture-packaged-macos-dictation-hotkey.ts --mode hands-free",
    "qa:packaged:macos:recovery-shortcuts": "bun scripts/capture-packaged-macos-recovery-shortcuts.ts",
    "qa:packaged:macos:app-matrix:equivalence": "bun scripts/capture-packaged-macos-component-equivalence.ts",
    "qa:packaged:macos:app-matrix:preflight": "bun scripts/capture-packaged-macos-app-matrix-preflight.ts",
    "qa:packaged:macos:app-matrix:insertion": "bun scripts/run-packaged-macos-app-matrix-insertion.ts",
    "qa:packaged:macos:release-audit": "bun scripts/capture-packaged-macos-release-audit.ts",
    "qa:packaged:macos:release-audit:pre": "bun scripts/capture-packaged-macos-release-audit.ts --phase pre",
    "qa:packaged:macos:release-audit:post": "bun scripts/capture-packaged-macos-release-audit.ts --phase post",
    "qa:diarization:fixture": "bun scripts/make-diarization-eval-fixture.ts",
    "qa:diarization:score": "bun scripts/score-diarization-eval.ts",
    "qa:source-gates": "bun scripts/capture-source-gates.ts",
    "qa:packaged:macos:idle-cpu": "bun scripts/capture-packaged-macos-idle-cpu.ts",
    "qa:packaged:macos:footprint": "bun scripts/capture-packaged-macos-footprint.ts",
    "qa:packaged:macos:update-metadata": "bun scripts/verify-packaged-macos-update-metadata.ts",
    "qa:packaged:macos:public-update-feed": "bun scripts/capture-public-update-feed.ts",
    "qa:packaged:macos:beta-update": "bun scripts/capture-packaged-macos-beta-update.ts",
    "qa:support-bundle": "bun scripts/capture-support-bundle.ts",
    "qa:packaged:macos:meeting:mic": "bun scripts/capture-packaged-macos-meeting-mic.ts",
    "qa:packaged:macos:meeting:system": "bun scripts/capture-packaged-macos-meeting-mic.ts --system-audio",
    "qa:packaged:macos:system-audio:test": "bun scripts/capture-packaged-macos-system-audio-test.ts",
    "qa:packaged:macos:meeting:soak": "bun scripts/capture-packaged-macos-meeting-soak.ts",
    "qa:packaged:macos:meeting:lifecycle": "bun scripts/capture-packaged-macos-meeting-lifecycle.ts",
    "qa:packaged:macos:retention": "bun scripts/capture-packaged-macos-retention.ts",
    "qa:packaged:macos:exports": "bun scripts/capture-packaged-macos-exports.ts"
  },
  "keywords": [
    "speech-to-text",
    "transcription",
    "dictation",
    "meeting-recorder",
    "ai",
    "whisper"
  ],
  "author": {
    "name": "Jonathan Reed",
    "url": "https://jonathanrreed.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/JonathanRReed/Plainsong",
  "website": "https://plainsong.jonathanrreed.com",
  "overrides": {
    "@electron/asar": "4.3.1",
    "@electron/get>undici": "7.30.1",
    "@xmldom/xmldom": "^0.8.15",
    "electron-builder-squirrel-windows": "26.15.3",
    "esbuild": "^0.28.2",
    "fast-uri": "3.1.9",
    "form-data": "^4.0.6",
    "glob": "14.0.2",
    "global-agent": "4.1.3",
    "ip-address": "^10.3.1",
    "js-yaml": "^4.3.2",
    "minimatch": "11.0.1",
    "nanoid": "^3.3.18",
    "node-gyp>undici": "6.29.1",
    "tar": "^7.5.22",
    "tmp": "^0.2.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JonathanRReed/Plainsong"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "electron-updater": "^6.8.11",
    "jose": "6.2.15",
    "lucide-react": "1.69.0",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "0.3.2",
    "tw-animate-css": "^1.4.0",
    "voice-glow": "0.3.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/osx-sign": "2.7.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "^10.6.2",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "knip": "6.44.1",
    "postcss": "8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "patchedDependencies": {
    "dir-compare@4.2.0": "patches/dir-compare@4.2.0.patch",
    "rimraf@2.6.3": "patches/rimraf@2.6.3.patch"
  }
}
