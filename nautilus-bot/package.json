{
  "name": "plainsong",
  "version": "1.0.0",
  "description": "Plainsong - free, open-source, local-first dictation and meeting capture",
  "productName": "Plainsong",
  "private": true,
  "packageManager": "bun@1.3.14",
  "main": "dist-electron/main.js",
  "scripts": {
    "lint": "bun run typecheck && bun run lint:rust",
    "lint:rust": "cargo fmt --manifest-path rust-sidecar/Cargo.toml --check && cargo clippy --locked --manifest-path rust-sidecar/Cargo.toml --all-targets -- -D warnings",
    "test": "vitest run",
    "test:vitest": "vitest run",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p tsconfig.electron.json",
    "dev": "bun run electron:compile && node scripts/dev-electron.mjs",
    "sidecar:build:release": "node scripts/build-rust-sidecar.mjs",
    "shortcut-helper:build": "node scripts/build-native-shortcut-helper.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "bun run electron:build",
    "preview": "vite preview",
    "electron:compile": "bun run build:electron",
    "electron:dev": "bun run dev",
    "electron:build": "bun run sidecar:build:release && bun run shortcut-helper:build && bun run build:renderer && bun run build:electron && node scripts/build-electron-release.mjs build",
    "electron:build:all": "bun run electron:build",
    "electron:build:mac": "node scripts/assert-host-platform.mjs darwin arm64 && bun run sidecar:build:release && bun run shortcut-helper:build && bun run build:renderer && bun run build:electron && electron-builder --mac zip --publish never",
    "electron:build:win": "node scripts/assert-host-platform.mjs win32 && bun run sidecar:build:release && bun run shortcut-helper:build && bun run build:renderer && bun run build:electron && electron-builder --win nsis --publish never",
    "electron:build:dmg": "node scripts/assert-host-platform.mjs darwin arm64 && bun run electron:build:mac && node scripts/build-dmg.mjs",
    "electron:pack": "bun run sidecar:build:release && bun run shortcut-helper:build && bun run build:renderer && bun run build:electron && node scripts/build-electron-release.mjs pack",
    "release:mac": "node scripts/assert-host-platform.mjs darwin arm64 && bun run sidecar:build:release && bun run shortcut-helper:build && bun run build:renderer && bun run build:electron && electron-builder --mac --publish never",
    "release:win": "node scripts/assert-host-platform.mjs win32 && bun run sidecar:build:release && bun run shortcut-helper:build && bun run build:renderer && bun run build:electron && electron-builder --win nsis --publish always",
    "test:rust": "cargo test --locked --manifest-path rust-sidecar/Cargo.toml --lib",
    "benchmark:latency": "cargo run --release --manifest-path rust-sidecar/Cargo.toml --bin benchmark-latency --",
    "gate:release-credentials:preflight": "node scripts/release-credentials-preflight.mjs",
    "gate:release:macos:trust": "node scripts/verify-macos-release-trust.mjs",
    "gate:packaged:macos:native": "node scripts/verify-packaged-native-helpers.mjs --app release/mac-arm64/Plainsong.app --arch arm64",
    "gate:size": "node scripts/size-gate.mjs --app release/mac-arm64/Plainsong.app --max-mb 450",
    "gate:cold-start": "node scripts/cold-start-gate.mjs --threshold-ms 2500 --ready-output-pattern \"App rendered\" --electron-logging -- release/mac-arm64/Plainsong.app/Contents/MacOS/Plainsong",
    "gate:ipc-contract": "node scripts/verify-ipc-contract.mjs",
    "gate:dead-code": "bunx --no-install knip --reporter compact --no-progress && node scripts/verify-dead-code-hygiene.mjs",
    "gate:release:local": "bun run lint && bun run test && bun run test:rust && bun run gate:ipc-contract && bun run electron:build",
    "qa:cloud-asr:smoke": "node scripts/live-cloud-asr-smoke.mjs --out artifacts/cloud-asr-smoke.json",
    "qa:asr:preflight": "node scripts/provision-asr-assets.mjs --validate-only --out artifacts/asr-preflight-macos.json",
    "qa:packaged:macos:smoke": "node scripts/capture-packaged-macos-smoke.mjs",
    "qa:packaged:macos:onboarding": "node scripts/capture-packaged-macos-onboarding-settings.mjs",
    "qa:packaged:macos:backup": "node scripts/capture-packaged-macos-backup-restore.mjs",
    "qa:packaged:macos:whisper": "node scripts/capture-packaged-macos-whisper-transcription.mjs",
    "qa:packaged:macos:ollama": "node scripts/capture-packaged-macos-ollama-analysis.mjs",
    "qa:packaged:macos:dictation-hotkey": "node scripts/capture-packaged-macos-dictation-hotkey.mjs",
    "qa:packaged:macos:dictation-hotkey:hold": "node scripts/capture-packaged-macos-dictation-hotkey.mjs --mode hold",
    "qa:packaged:macos:dictation-hotkey:hands-free": "node scripts/capture-packaged-macos-dictation-hotkey.mjs --mode hands-free",
    "qa:packaged:macos:recovery-shortcuts": "node scripts/capture-packaged-macos-recovery-shortcuts.mjs",
    "qa:packaged:macos:app-matrix:preflight": "node scripts/capture-packaged-macos-app-matrix-preflight.mjs",
    "qa:packaged:macos:app-matrix:insertion": "node scripts/run-packaged-macos-app-matrix-insertion.mjs",
    "qa:packaged:macos:idle-cpu": "node scripts/capture-packaged-macos-idle-cpu.mjs",
    "qa:packaged:macos:update-metadata": "node scripts/verify-packaged-macos-update-metadata.mjs",
    "qa:packaged:macos:meeting:mic": "node scripts/capture-packaged-macos-meeting-mic.mjs",
    "qa:packaged:macos:meeting:system": "node scripts/capture-packaged-macos-meeting-mic.mjs --system-audio --out artifacts/qa/macos/capture-meeting-system-audio.json",
    "qa:packaged:macos:system-audio:test": "node scripts/capture-packaged-macos-system-audio-test.mjs",
    "qa:packaged:macos:meeting:soak": "node scripts/capture-packaged-macos-meeting-soak.mjs",
    "qa:packaged:macos:retention": "node scripts/capture-packaged-macos-retention.mjs",
    "qa:packaged:macos:exports": "node scripts/capture-packaged-macos-exports.mjs"
  },
  "keywords": [
    "speech-to-text",
    "transcription",
    "dictation",
    "meeting-recorder",
    "ai",
    "whisper"
  ],
  "author": {
    "name": "Jonathan Reed",
    "url": "https://jonathanrreed.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/JonathanRReed/Plainsong",
  "website": "https://plainsong.jonathanrreed.com",
  "overrides": {
    "esbuild": "^0.27.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JonathanRReed/Plainsong"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.0",
    "knip": "6.29.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  }
}
