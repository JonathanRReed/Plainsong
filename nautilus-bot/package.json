{
  "name": "nautilus-bot",
  "version": "1.0.0",
  "description": "Nautilus - Verifiable Memory Layer for dictation and meeting capture",
  "productName": "Nautilus",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "lint": "bun run typecheck && cargo fmt --manifest-path rust-sidecar/Cargo.toml --check && cargo clippy --manifest-path rust-sidecar/Cargo.toml --all-targets -- -D warnings",
    "test": "vitest run",
    "test:vitest": "vitest run",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p tsconfig.electron.json",
    "dev": "bun run electron:compile && node scripts/dev-electron.mjs",
    "sidecar:build:release": "cargo build --release --manifest-path rust-sidecar/Cargo.toml --bin nautilus-sidecar",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "bun run electron:build",
    "preview": "vite preview",
    "electron:compile": "bun run build:electron",
    "electron:dev": "bun run dev",
    "electron:build": "bun run sidecar:build:release && bun run build:renderer && bun run build:electron && node scripts/build-electron-release.mjs build",
    "electron:build:all": "bun run electron:build",
    "electron:build:mac": "node scripts/assert-host-platform.mjs darwin && bun run sidecar:build:release && bun run build:renderer && bun run build:electron && electron-builder --mac zip --publish never",
    "electron:build:win": "node scripts/assert-host-platform.mjs win32 && bun run sidecar:build:release && bun run build:renderer && bun run build:electron && electron-builder --win nsis --publish never",
    "electron:build:dmg": "node scripts/assert-host-platform.mjs darwin && bun run electron:build:mac && node scripts/build-dmg.mjs",
    "electron:pack": "bun run sidecar:build:release && bun run build:renderer && bun run build:electron && node scripts/build-electron-release.mjs pack",
    "gate:size": "node scripts/size-gate.mjs --app release/mac-arm64/Nautilus.app --max-mb 450",
    "gate:release:local": "node scripts/verify-local-release.mjs",
    "gate:dictation:artifacts": "node scripts/refresh-dictation-parity-artifacts.mjs",
    "gate:blockers:refresh": "node scripts/refresh-dictation-parity-artifacts.mjs && node scripts/refresh-blocker-artifacts.mjs && node scripts/export-qa-evidence-bundle.mjs --matrix docs/packaged-app-qa-matrix.md --out artifacts/packaged-qa-evidence-bundle.json",
    "benchmark:dictation:fixture": "node scripts/generate-dictation-benchmark.mjs --fixtures docs/evals/dictation-parity-fixture.json --out artifacts/evals/dictation-benchmark-run.json",
    "benchmark:dictation:baseline:dev": "node scripts/generate-dictation-benchmark.mjs --fixtures docs/evals/dictation-parity-fixture.json --out artifacts/evals/dictation-benchmark-baseline-dev.json",
    "benchmark:dictation:fixtures:refresh": "node scripts/refresh-local-benchmark-artifacts.mjs",
    "benchmark:dictation:macos": "node scripts/capture-macos-dictation-benchmark.mjs",
    "benchmark:dictation:macos:promote-baseline": "node scripts/capture-macos-dictation-benchmark.mjs --promote-baseline",
    "benchmark:dictation:windows": "node scripts/capture-windows-dictation-benchmark.mjs",
    "benchmark:dictation:windows:promote-baseline": "node scripts/capture-windows-dictation-benchmark.mjs --promote-baseline",
    "gate:benchmark:macos": "node scripts/verify-benchmark-gates.mjs --schema docs/evals/benchmark-run.schema.json --baseline docs/evals/benchmark-run-baseline.json --candidate docs/evals/benchmark-run-latest-macos.json --out artifacts/benchmark-gates-macos.json",
    "gate:benchmark:windows": "node scripts/verify-benchmark-gates.mjs --schema docs/evals/benchmark-run.schema.json --baseline docs/evals/benchmark-run-baseline.json --candidate docs/evals/benchmark-run-latest-windows.json --out artifacts/benchmark-gates-windows.json"
  },
  "keywords": [
    "speech-to-text",
    "transcription",
    "dictation",
    "meeting-recorder",
    "ai",
    "whisper"
  ],
  "author": "NautilusBot",
  "license": "MIT",
  "homepage": "https://nautilusbot.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/nautilusbot/nautilus"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.563.0",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  }
}
